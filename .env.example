# Banco local SQLite para desenvolvimento (Node 24+).
DATABASE_PATH=.data/axl.sqlite
# Crie o administrador com npm run db:seed. Nunca use senha real no código.
AXL_ADMIN_EMAIL=admin@axl.local
AXL_ADMIN_PASSWORD=
# Somente desenvolvimento local: demonstração com dados fictícios.
AXL_DEMO_SEED=true
# Backend: local para desenvolvimento; supabase para acesso compartilhado e Vercel.
AXL_BACKEND=local
# Execute os três arquivos database/supabase*.sql na ordem indicada no README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_PLACES_API_KEY=
# Importação automática por link usa apenas Places API (New); manual funciona sem chave.
# Autenticação local não é habilitada em produção por padrão.
AXL_ALLOW_LOCAL_AUTH=false

# Opcional: somente servidor, para criar usuários pela interface. Não necessário para login.
SUPABASE_ADMIN_KEY=
# Opcional: URL pública canônica do OAuth/MCP, sem barra final.
AXL_PUBLIC_URL=
